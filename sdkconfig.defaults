CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# UART0 TX conflicts with the LCD backlight on GPIO21.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_BUTTON_PERIOD_TIME_MS=10

CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_MEM_SIZE_KILOBYTES=24

# The badge-only firmware has enough headroom for a reliable phone DHCP/HTTP data path while
# remaining well below ESP-IDF's 10/32/32 defaults on the no-PSRAM target.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUFFER=y
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=5
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=12

# Before a DHCP client owns its offered address, deliver OFFER/ACK as broadcast frames.
# Temporary static ARP entries make ESP-IDF use unicast here; the phone can miss those ACKs,
# retry DHCP, and eventually fall back to a 169.254/16 link-local address.
CONFIG_LWIP_DHCPS_STATIC_ENTRIES=n

# The badge/display firmware must not compile or link a Bluetooth stack.
CONFIG_BT_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n
